{
  "schemaVersion": 1,
  "id": "enochlawrence.yutaro-assistant",
  "name": "Yutaro Assistant",
  "version": "0.3.0",
  "author": "Enoch Lawrence",
  "description": "A Taby-inspired assistant overlay for Omarchy.",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "YutaroOverlay.qml",
    "barWidget": "YutaroBarWidget.qml"
  },
  "barWidget": {
    "displayName": "Yutaro",
    "description": "Open the Yutaro assistant overlay.",
    "category": "Assistant",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
